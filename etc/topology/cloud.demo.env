# cloud.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_assets_demo`
# and (when the base profile uses Redis) a dedicated Redis logical DB index / key prefix so no cache
# key (rate-limit, session, idempotency, ...) ever collides with another shared-redis environment.
# NOTE: demo MUST use an independent database schema `sdkwork_assets_demo` for isolation.
# NOTE: if Redis is used, demo MUST target a dedicated Redis logical DB index / distinct key prefix so it never collides with other environments on shared Redis.
SDKWORK_ASSETS_DEPLOYMENT_PROFILE=cloud
SDKWORK_ASSETS_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_ASSETS_PROFILE_ID=cloud.demo
VITE_SDKWORK_ASSETS_DEPLOYMENT_PROFILE=cloud
VITE_SDKWORK_ASSETS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_ASSETS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_ASSETS_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_ASSETS_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_ASSETS_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN


