# SDKWork local-only and generated artifacts
.env
.env.*
!.env.example
!.env.*.example
**/build/
*.log
.DS_Store
Thumbs.db

# Runtime-generated env config (modified by local dev server)
**/public/runtime-env.json

# Local artifacts and build output (do not commit)
sdks/**/package-lock.json

# SDK generated/transpiled output (local regeneration product, not committed)
*.js.map
*.d.ts.map
# SDK facade transpiled output (build artifacts, not committed)
sdks/**/*-typescript/src/*.js
sdks/**/*-typescript/src/*.d.ts
sdks/**/composed/*.js
sdks/**/composed/*.d.ts

# --- SDKWork: generated TypeScript SDK build outputs (never committed) ---
**/generated/server-openapi/src/**/*.js
**/generated/server-openapi/src/**/*.js.map
**/generated/server-openapi/src/**/*.d.ts
**/generated/server-openapi/src/**/*.d.ts.map
**/composed/**/*.js.map
**/composed/**/*.d.ts.map

# Python bytecode: regenerated by the interpreter on import, not authored content
__pycache__/

# Agent scratch: session memory and generated reports (the portability and
# shell-portability gates exclude this directory as scratch too)
.workbuddy/

# The negations below keep authored ambient declarations committable.

# Compiler emit is ignored only where the file is emit BY DEFINITION. The broad
# `**/src/**/*.js` / `**/src/**/*.d.ts` globs are gone: `.gitignore` cannot express "ignore
# this only when a same-stem .ts sibling exists", so they also hid authored declarations
# (`vite-env.d.ts`, `styles.d.ts`, module shims) and real mini-program source under `src/`.
# The sibling rule is enforced against tracked files by
# `sdkwork-specs/tools/check-repository-baseline-content.mjs` instead.
