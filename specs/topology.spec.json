{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-assets",
  "applicationCode": "assets",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production",
        "demo"
      ]
    },
    "connectivityPlane": {
      "allowed": [
        "application",
        "platform"
      ]
    },
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env",
    "standalone.demo": "etc/topology/standalone.demo.env",
    "cloud.demo": "etc/topology/cloud.demo.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_ASSETS_DEPLOYMENT_PROFILE",
    "clientDeploymentProfile": "VITE_SDKWORK_ASSETS_DEPLOYMENT_PROFILE",
    "apiGatewayBaseUrl": "SDKWORK_ASSETS_PLATFORM_API_GATEWAY_HTTP_URL",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_ASSETS_PLATFORM_API_GATEWAY_HTTP_URL",
    "clientApplicationPublicHttpUrl": "VITE_SDKWORK_ASSETS_APPLICATION_PUBLIC_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_ASSETS_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_ASSETS_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_ASSETS_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_ASSETS_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_ASSETS_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "web-renderer",
            "package": "sdkwork-assets-pc-react",
            "script": "dev",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": []
      },
      "cloud.development": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.production": {
        "processes": [
          {
            "id": "web-renderer",
            "package": "sdkwork-assets-pc-react",
            "script": "build",
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "platform.api-gateway"
        ]
      },
      "standalone.production": {
        "processes": [
          {
            "id": "web-renderer",
            "package": "sdkwork-assets-pc-react",
            "script": "dev",
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": []
      },
      "standalone.test": {
        "processes": [
          {
            "id": "web-renderer",
            "package": "sdkwork-assets-pc-react",
            "script": "dev",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": []
      },
      "standalone.staging": {
        "processes": [
          {
            "id": "web-renderer",
            "package": "sdkwork-assets-pc-react",
            "script": "dev",
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": []
      },
      "cloud.test": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.staging": {
        "processes": [
          {
            "id": "web-renderer",
            "package": "sdkwork-assets-pc-react",
            "script": "build",
            "required": true,
            "role": "client"
          }
        ],
        "healthSurfaces": [
          "platform.api-gateway"
        ]
      },
      "standalone.demo": {
        "processes": [],
        "healthSurfaces": []
      },
      "cloud.demo": {
        "processes": [],
        "healthSurfaces": []
      }
    }
  },
  "packaging": {
    "targets": [
      {
        "id": "web-browser-static",
        "profile": "cloud.production",
        "platform": "web",
        "architecture": "any",
        "formats": [
          "static"
        ]
      }
    ],
    "cloudConfigFiles": []
  },
